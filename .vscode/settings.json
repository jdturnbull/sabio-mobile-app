{
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": false
    },
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "files.exclude": {
      "**/node_modules": true,
      ".git": true
    },
    "search.exclude": {
      "**/*.code-search": false,
      "**/bower_components": false,
      "**/node_modules": false
    }
  }